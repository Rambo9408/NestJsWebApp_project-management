# =============================================================================
# TaskFlow API - environment template
# =============================================================================
# HOW THIS WORKS
#   1. This file is COMMITTED to git. It is documentation: it tells the next
#      developer (and the CI pipeline) which variables exist and what they mean.
#   2. It contains NO real secrets - only placeholders.
#   3. Real values live in `.env.development` / `.env.test` (local, gitignored
#      for anything sensitive) or, in production, in the platform's secret
#      manager (AWS Secrets Manager, GCP Secret Manager, k8s Secret, Doppler...).
#
# WHY NOT JUST ONE .env?
#   Because "which database did that test just wipe?" is a question you only
#   want to ask once. Per-environment files make the blast radius explicit.
#
# Loading order is defined in src/config/config.module.ts:
#   .env.${NODE_ENV}  (wins)  ->  .env  (fallback)
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=test
PORT=3001
APP_NAME=taskflow-api
# Everything is served under this prefix, e.g. GET /api/v1/health
API_PREFIX=api
# Comma-separated list, or `*` for "allow all" (NEVER `*` in production when
# you also send credentials - see README > Security).
CORS_ORIGINS=http://localhost:5173,http://localhost:4200,http://localhost:3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=silent

# --- MongoDB -----------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27018/taskflow_test?directConnection=true
# Connection pool. Mongoose keeps a pool of sockets per process; too small and
# requests queue behind each other, too large and you exhaust the server's
# connection limit (see README > Performance).
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2

# --- Redis (cache + BullMQ queues + pub/sub for SSE fan-out) -----------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
# Namespacing every key means two environments can share one Redis instance
# without stomping on each other, and `KEYS taskflow:dev:*` stays useful.
REDIS_KEY_PREFIX=taskflow:test

# --- Auth / JWT --------------------------------------------------------------
# CHANGE THESE. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Access and refresh secrets MUST be different - see README > Authentication.
JWT_ACCESS_SECRET=test-only-access-secret-000000000000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=test-only-refresh-secret-000000000000000000
JWT_REFRESH_TTL=7d

# --- Caching -----------------------------------------------------------------
# Default TTL (seconds) for cache-aside entries when a caller does not specify.
CACHE_DEFAULT_TTL=60

# --- Rate limiting -----------------------------------------------------------
# "limit" requests allowed per "ttl" milliseconds, per client.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- API docs ----------------------------------------------------------------
# Serving Swagger publicly in production leaks your entire attack surface.
# Keep it false in prod, or put it behind auth.
SWAGGER_ENABLED=false
